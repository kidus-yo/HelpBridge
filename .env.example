# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
# Development: omit DATABASE_URL to use local SQLite.
# Production: PostgreSQL is required. SQLite is rejected when DJANGO_ENV=production.
# DATABASE_URL=postgres://helpbridge:helpbridge@localhost:5432/helpbridge

# Platform context tokens (server-side signing key — never send to the browser)
PLATFORM_CONTEXT_SIGNING_KEY=replace-with-a-separate-signing-secret
PLATFORM_CONTEXT_TTL_SECONDS=900

# Knowledge documents
DOCUMENT_MAX_UPLOAD_MB=10
DOCUMENT_STORAGE_BACKEND=local
EMBEDDING_PROVIDER=hash

# AI Engine
AI_PROVIDER=offline
AI_CLOUD_PROVIDER=openai
AI_CLOUD_API_KEY=
AI_CLOUD_MODEL=gpt-4o-mini
AI_LOCAL_ENDPOINT=http://localhost:11434/v1
AI_LOCAL_MODEL=llama3
AI_GROUNDING_THRESHOLD=0.25

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=DigitalBridgeAssistantBot

# SMS
SMS_GATEWAY_API_KEY=
SMS_DEFAULT_SENDER=+251911000000

DEFAULT_LANGUAGE=am
