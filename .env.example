# Django Settings
SECRET_KEY=django-insecure-digital-bridge-hackathon-2026-demo-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# Database (defaults to SQLite if DATABASE_URL is not set)
# DATABASE_URL=postgres://user:password@localhost:5432/digital_bridge

# AI Engine Configuration
# Providers: "offline" (keyword search + fallback), "cloud" (OpenAI/Gemini/etc), "local" (Ollama), "mock"
AI_PROVIDER=offline
AI_CLOUD_PROVIDER=openai
AI_CLOUD_API_KEY=
AI_CLOUD_MODEL=gpt-4o-mini
AI_LOCAL_ENDPOINT=http://localhost:11434/v1
AI_LOCAL_MODEL=llama3
AI_GROUNDING_THRESHOLD=0.25

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=DigitalBridgeAssistantBot

# SMS Configuration
SMS_GATEWAY_API_KEY=
SMS_DEFAULT_SENDER=+251911000000

# Default Language (am = Amharic, en = English)
DEFAULT_LANGUAGE=am
